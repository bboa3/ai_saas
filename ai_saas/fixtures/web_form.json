  "client_script": "frappe.web_form.after_load = () => {\n  const params = new URLSearchParams(window.location.search);\n  const contract = params.get('contract');\n  const type = params.get('type');\n  if (contract) frappe.web_form.set_value('contract', contract);\n  frappe.web_form.set_value('feedback_type', type === 'monthly' ? 'Primeiro Mês' : 'Primeiros Passos');\n  _render_star_rating();\n};\n\nfunction _render_star_rating() {\n  var labels = ['', 'Muito insatisfeito', 'Insatisfeito', 'Neutro', 'Satisfeito', 'Muito satisfeito'];\n  var selected = 0;\n\n  var $widget = $('<div id=\"mz-star-rating\" style=\"margin:24px 0 16px 0;\"><div class=\"mz-stars\" style=\"display:flex;gap:2px;justify-content:center;margin-bottom:10px;\"></div><div class=\"mz-label\" style=\"text-align:center;font-size:13px;color:#52606d;min-height:18px;font-weight:500;\"></div></div>');\n\n  var $stars = $widget.find('.mz-stars');\n  var $lbl = $widget.find('.mz-label');\n\n  for (var i = 1; i <= 5; i++) {\n    (function(val) {\n      var $s = $('<div data-v=\"' + val + '\" style=\"display:flex;flex-direction:column;align-items:center;cursor:pointer;flex:1;max-width:72px;\"><span style=\"font-size:48px;line-height:1;color:#C3C7CE;transition:color 0.12s,transform 0.1s;display:block;user-select:none;\">&#9733;</span><span style=\"font-size:11px;color:#bbb;margin-top:5px;\">' + val + '</span></div>');\n\n      $s.on('mouseenter', function() {\n        _paint($stars, val, false);\n        $lbl.text(labels[val]);\n      });\n\n      $s.on('click', function() {\n        selected = val;\n        frappe.web_form.set_value('rating', String(val));\n        _paint($stars, val, true);\n        $lbl.text(labels[val]);\n      });\n\n      $stars.append($s);\n    })(i);\n  }\n\n  $stars.on('mouseleave', function() {\n    _paint($stars, selected, selected > 0);\n    $lbl.text(selected ? labels[selected] : '');\n  });\n\n  $('[data-fieldname=\"feedback_text\"]').closest('.frappe-control').before($widget);\n}\n\nfunction _paint($stars, val, lock) {\n  $stars.find('[data-v]').each(function() {\n    var v = parseInt($(this).data('v'));\n    var active = v <= val;\n    $(this).find('span:first').css({\n      color: active ? '#f5a623' : '#C3C7CE',\n      transform: (lock && active) ? 'scale(1.08)' : 'scale(1)'\n    });\n    $(this).find('span:last').css('color', active ? '#f5a623' : '#C3C7CE');\n  });\n}",
